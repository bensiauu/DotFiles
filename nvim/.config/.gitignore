# This directory is the target of ~/.config -> DotFiles/nvim/.config,
# so the whole real ~/.config bleeds in here. Only track the packages
# that actually belong to the dotfiles; ignore everything else
# (gh/argocd/.jira/git/copilot/... contain live credentials).
/*
!/nvim
!/zellij
!/.gitignore

# Track only herdr's config.toml; the dir also holds live logs, sockets,
# session state, and plugin locks that must stay untracked.
!/herdr
/herdr/*
!/herdr/config.toml
